# Local dev: leave DB_CLIENT as sqlite3, nothing else needed.
DB_CLIENT=sqlite3
SQLITE_PATH=./educore.sqlite3

# Production (cPanel-style MySQL hosting): set DB_CLIENT=mysql2 and fill these in.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=educore

JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
